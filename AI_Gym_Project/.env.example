# .env.example
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# The app reads these via python-dotenv (loaded in constants.py).
# ─────────────────────────────────────────────────────────────

# Get your free Gemini API key at:
# https://makersuite.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# MongoDB settings
# Local default example:
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=ai_gym_assistant
MONGODB_USERS_COLLECTION=user_profiles

# Grounded RAG (Gym Buddy knowledge retrieval over the Exercise Library)
# Defaults are fine; embeddings are built once via scripts/build_embeddings.py
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
RAG_TOP_K=4
RAG_MIN_SCORE=0.35
RAG_MAX_CONTEXT_CHARS=3500
